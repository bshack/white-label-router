{
  "name": "white-label-router",
  "version": "5.0.0",
  "description": "A simple ES6 JS router",
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bshack/white-label-router.git"
  },
  "contributors": [
    {
      "name": "Bill Shackelford",
      "url": "https://github.com/bshack"
    }
  ],
  "keywords": [
    "js",
    "javacript",
    "router",
    "es6",
    "es2015",
    "delegate"
  ],
  "author": "bshack",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bshack/white-label-router/issues"
  },
  "homepage": "https://github.com/bshack/white-label-router#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && npm run test:types && npm run test:unit",
    "audit": "npm audit --audit-level=high",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test test/*.test.js",
    "coverage": "npm run build && npm run test:types && c8 npm run test:unit",
    "prepack": "npm run build",
    "test:types": "tsc -p tsconfig.consumer.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "typescript": "7.0.2"
  },
  "types": "dist/index.d.ts",
  "c8": {
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "reporter": [
      "text",
      "json",
      "json-summary",
      "lcov"
    ],
    "excludeAfterRemap": true,
    "checkCoverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "perFile": true,
    "exclude": [
      "**/*.d.ts"
    ]
  }
}
